# ── Server env for /opt/akt-website-v2/.env (NEVER commit the real file) ────────
# docker compose reads this. Copy to /opt/akt-website-v2/.env and fill in secrets.

# Meilisearch master key — generate: openssl rand -hex 32
MEILI_MASTER_KEY=REPLACE_WITH_openssl_rand_hex_32

# Auth cookie signing secret — generate: openssl rand -hex 32
AUTH_COOKIE_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Backend JSON API (react-api). STAGING for now.
API_BASE_URL=https://mrtechnobaba.co.in
# Staging TLS cert is self-signed → allow it. MUST be false when API_BASE_URL is prod.
API_ALLOW_SELF_SIGNED=true

# Public origin + analytics (also baked into the image at build; keep in sync).
NEXT_PUBLIC_SITE_URL=https://v2.mrtechnobaba.co.in
NEXT_PUBLIC_GTM_ID=GTM-W7P4G5S
# Keep staging non-indexable so Google never sees the staging site.
NEXT_PUBLIC_INDEXABLE=false
