# Copy to .env.local and adjust.
#
# The existing react-api base URL. Two options while building:
#   Staging (writes safe, but self-signed cert → also set API_ALLOW_SELF_SIGNED=true):
#     API_BASE_URL=https://mrtechnobaba.co.in
#   Prod READ-ONLY (valid cert + real data; catalog phases only — write endpoints are BLOCKED):
#     API_BASE_URL=https://akinfotools.com  +  API_READ_ONLY=true
API_BASE_URL=https://akinfotools.com

# Read-only guard: when true, the client refuses cart/checkout/auth/address writes.
# Use with prod. Turn OFF (and switch to staging) when building cart/checkout/account (P5+).
API_READ_ONLY=true

# Public canonical site origin (used for links, canonical tags, sitemaps).
NEXT_PUBLIC_SITE_URL=https://v2.mrtechnobaba.co.in

# SEO/analytics gate. FALSE on staging (site is noindexed + no GTM) → prod SEO never leaks.
# Set to true ONLY on the production akinfotools.com deployment.
NEXT_PUBLIC_INDEXABLE=false
# Google Tag Manager container (GA4 + Ads + Merchant tags live inside GTM). Empty = analytics off.
NEXT_PUBLIC_GTM_ID=

# Meilisearch — powers search + category/brand listing. Run `npm run reindex` to (re)build it.
MEILI_HOST=http://127.0.0.1:7700
MEILI_ADMIN_KEY=akt_dev_master
# Optional read-only key for query-time (falls back to admin key if unset):
# MEILI_SEARCH_KEY=

# Secret used to sign/verify the auth cookie (generate: openssl rand -hex 32).
AUTH_COOKIE_SECRET=change-me-openssl-rand-hex-32

# Staging api (mrtechnobaba.co.in) has a SELF-SIGNED TLS cert → allow it in DEV/STAGING only.
# MUST be false/removed in production (akinfotools.com has a valid cert).
API_ALLOW_SELF_SIGNED=true
